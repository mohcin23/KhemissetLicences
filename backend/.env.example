PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=khemisset_db
DB_PORT=3306
MISTRAL_API_KEY=your_key_here
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
# Origins autorisées (séparées par virgule) — ex: http://localhost:3000,https://votre-domaine.ma
CORS_ORIGINS=http://localhost:3000
# Délai SLA en heures (défaut: 120h = 5 jours ouvrés)
SLA_HEURES_ANALYSE=120

# Répertoire de stockage des pièces jointes (chemin absolu ou relatif)
UPLOAD_DIR=./uploads/pieces_jointes
